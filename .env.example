# Local Docker Compose overrides. Replace these development values before sharing the app.
MYSQL_ROOT_PASSWORD=manager
MYSQL_PORT=3306
BACKEND_PORT=8080
WEB_PORT=3000

# Okta OIDC — required by the backend resource server.
OKTA_ISSUER_URI=https://your-tenant.okta.com/oauth2/default
OKTA_AUDIENCE=api://neo
OKTA_GROUPS_CLAIM=groups

# Web OIDC client — required for the Next.js sign-in flow.
OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET is only needed for confidential clients.
# OKTA_CLIENT_SECRET=
OKTA_SCOPES=openid profile email
NEXT_PUBLIC_APP_URL=http://localhost:3000
