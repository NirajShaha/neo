# Backend API Configuration (Spring Boot + Flowable)
# Used server-side only: Okta callback, session checks, API proxy.
BACKEND_URL=http://localhost:8080

# Okta OIDC (single-tenant authorization server)
OKTA_ISSUER_URI=
OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET is only needed for confidential clients.
OKTA_CLIENT_SECRET=
OKTA_SCOPES=openid profile email

# Public origin used to build the OIDC redirect URI (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
