<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://neo.com/workflow"
             exporter="NEO">
  <process id="jlrAmpP023ProcurementAuthorityV2"
           name="JLR-AMP-P-023 Procurement Authority V2"
           isExecutable="true">
    <documentation>Converted from the JLR-AMP-P-023 Procurement Authority V2 diagram. Set process variables moqUopChange, atbBbRequired, commercialChange, approved, and procurementType (ATB_BB or MOQ_CHANGE).</documentation>

    <laneSet id="laneSet_procurement">
      <lane id="lane_function" name="Function">
        <flowNodeRef>startProcurement</flowNodeRef>
        <flowNodeRef>procurementTypeStartGateway</flowNodeRef>
        <flowNodeRef>getQuotes</flowNodeRef>
        <flowNodeRef>requestForecast</flowNodeRef>
        <flowNodeRef>enterCommercial</flowNodeRef>
        <flowNodeRef>completeImpact</flowNodeRef>
        <flowNodeRef>openAuthorityLog</flowNodeRef>
        <flowNodeRef>atbBbRequiredGateway</flowNodeRef>
        <flowNodeRef>openImpactLog</flowNodeRef>
        <flowNodeRef>wait24Hours</flowNodeRef>
        <flowNodeRef>obtainReference</flowNodeRef>
        <flowNodeRef>atbBbCheck</flowNodeRef>
        <flowNodeRef>addTurnDown</flowNodeRef>
        <flowNodeRef>updateAuthorityWithImpact</flowNodeRef>
        <flowNodeRef>submitApproval</flowNodeRef>
        <flowNodeRef>approvedGateway</flowNodeRef>
        <flowNodeRef>reasonForRejection</flowNodeRef>
        <flowNodeRef>commercialGateway</flowNodeRef>
        <flowNodeRef>updateBusinessCase</flowNodeRef>
        <flowNodeRef>typeGateway</flowNodeRef>
        <flowNodeRef>updateAuthorityFinal</flowNodeRef>
        <flowNodeRef>updateSap</flowNodeRef>
        <flowNodeRef>sendApprovalToIm</flowNodeRef>
        <flowNodeRef>openCirGateway</flowNodeRef>
        <flowNodeRef>updateDeliveryDate</flowNodeRef>
        <flowNodeRef>endFunction</flowNodeRef>
      </lane>
      <lane id="lane_im" name="IM">
        <flowNodeRef>extendedForecast</flowNodeRef>
        <flowNodeRef>updateTurnDown</flowNodeRef>
        <flowNodeRef>updateOrders</flowNodeRef>
        <flowNodeRef>updateBuyerPlanner</flowNodeRef>
        <flowNodeRef>endIm</flowNodeRef>
      </lane>
    </laneSet>

    <startEvent id="startProcurement" name="Start"/>
    <exclusiveGateway id="procurementTypeStartGateway" name="ATB or BB required?" default="flow-start-moq"/>

    <userTask id="getQuotes" name="Get new or updated quotes from supplier" flowable:formKey="supplierQuotes"/>
    <userTask id="requestForecast" name="Request ATB or BB forecast from Inventory Management" flowable:formKey="atbBbForecast"/>
    <userTask id="extendedForecast" name="Create extended forecast for buyer" flowable:formKey="extendedForecast"/>
    <userTask id="enterCommercial" name="Enter most appropriate business or commercial outcome" flowable:formKey="commercialOutcome"/>
    <userTask id="completeImpact" name="Complete the impact outcome in the Impact Calculator (JLR-AMP-P-F068/F081)" flowable:formKey="impactCalculator"/>
    <userTask id="openAuthorityLog" name="Open Procurement Authority Log (JLR-AMP-P-F231) and complete or update required fields" flowable:formKey="procurementAuthorityLog"/>

    <exclusiveGateway id="atbBbRequiredGateway" name="ATB or BB?" default="flow-submit-no-atb"/>

    <userTask id="openImpactLog" name="Open and complete/update the Impact Log or Unitpart Space Impact Log using the data from the PA form" flowable:formKey="impactLog"/>
    <intermediateCatchEvent id="wait24Hours" name="Wait 24 hours">
      <timerEventDefinition>
        <timeDuration>PT24H</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <userTask id="obtainReference" name="Obtain reference number and space impact value" flowable:formKey="impactReference"/>
    <exclusiveGateway id="atbBbCheck" name="ATB or BB?" default="flow-add-turn-down"/>
    <userTask id="addTurnDown" name="Add part to the Turn Down Log (JLR-AMP-P-F295)" flowable:formKey="turnDownLog"/>
    <userTask id="updateAuthorityWithImpact" name="Update Procurement Authority form with Space Impact Value" flowable:formKey="procurementAuthorityLog"/>
    <userTask id="updateTurnDown" name="Update Turn Down Log (JLR-AMP-P-F295)" flowable:formKey="turnDownLog"/>

    <userTask id="submitApproval" name="Submit for approval at AM/IM Governance where applicable and raise eSign" flowable:formKey="procurementApproval"/>
    <exclusiveGateway id="approvedGateway" name="Approved?" default="flow-rejected"/>
    <userTask id="reasonForRejection" name="Reason for rejection" flowable:formKey="rejectionReason"/>
    <exclusiveGateway id="commercialGateway" name="Commercial?" default="flow-update-business"/>
    <userTask id="updateBusinessCase" name="Update business case or justification and re-submit" flowable:formKey="commercialJustification"/>

    <exclusiveGateway id="typeGateway" name="MOQ/UOP or ATB/BB?" default="flow-moq-change"/>
    <userTask id="updateAuthorityFinal" name="Update the Procurement Authority Log (JLR-AMP-P-F231) with final status of parts" flowable:formKey="procurementAuthorityLog"/>
    <userTask id="updateSap" name="Update SAP with new MOQ/UOP" flowable:formKey="sapUpdate"/>
    <userTask id="sendApprovalToIm" name="Send approval to IM instruction to amend the order for the part" flowable:formKey="imInstruction"/>
    <exclusiveGateway id="openCirGateway" name="Open CIR?" default="flow-no-cir"/>
    <userTask id="updateDeliveryDate" name="Update estimated time of arrival of the next/first delivery of parts on CIR (JLR-AMP-LWI-064 Aftermarket Commercial Issue Resolution)" flowable:formKey="cirUpdate"/>

    <userTask id="updateOrders" name="Update orders in relevant IM system" flowable:formKey="orderUpdate"/>
    <userTask id="updateBuyerPlanner" name="Update buyer and planner" flowable:formKey="buyerPlannerUpdate"/>

    <endEvent id="endFunction" name="End"/>
    <endEvent id="endIm" name="End"/>

    <sequenceFlow id="flow-start" sourceRef="startProcurement" targetRef="procurementTypeStartGateway"/>
    <sequenceFlow id="flow-start-moq" name="No" sourceRef="procurementTypeStartGateway" targetRef="getQuotes"/>
    <sequenceFlow id="flow-start-atb" name="Yes" sourceRef="procurementTypeStartGateway" targetRef="requestForecast">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${atbBbRequired == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-request-forecast" sourceRef="requestForecast" targetRef="extendedForecast"/>
    <sequenceFlow id="flow-extended-forecast" sourceRef="extendedForecast" targetRef="getQuotes"/>
    <sequenceFlow id="flow-quotes" sourceRef="getQuotes" targetRef="enterCommercial"/>
    <sequenceFlow id="flow-commercial" sourceRef="enterCommercial" targetRef="completeImpact"/>
    <sequenceFlow id="flow-impact" sourceRef="completeImpact" targetRef="openAuthorityLog"/>
    <sequenceFlow id="flow-authority-log" sourceRef="openAuthorityLog" targetRef="atbBbRequiredGateway"/>

    <sequenceFlow id="flow-atb-required" name="Yes" sourceRef="atbBbRequiredGateway" targetRef="openImpactLog">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${atbBbRequired == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-submit-no-atb" name="No" sourceRef="atbBbRequiredGateway" targetRef="submitApproval"/>
    <sequenceFlow id="flow-open-impact" sourceRef="openImpactLog" targetRef="wait24Hours"/>
    <sequenceFlow id="flow-wait-impact" sourceRef="wait24Hours" targetRef="obtainReference"/>
    <sequenceFlow id="flow-reference" sourceRef="obtainReference" targetRef="atbBbCheck"/>
    <sequenceFlow id="flow-impact-atb" name="ATB" sourceRef="atbBbCheck" targetRef="addTurnDown">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${procurementType == 'ATB_BB'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-add-turn-down" name="BB" sourceRef="atbBbCheck" targetRef="updateAuthorityWithImpact"/>
    <sequenceFlow id="flow-turn-down" sourceRef="addTurnDown" targetRef="updateTurnDown"/>
    <sequenceFlow id="flow-turn-down-authority" sourceRef="updateTurnDown" targetRef="updateAuthorityWithImpact"/>
    <sequenceFlow id="flow-impact-authority" sourceRef="updateAuthorityWithImpact" targetRef="submitApproval"/>

    <sequenceFlow id="flow-submit-approval" sourceRef="submitApproval" targetRef="approvedGateway"/>
    <sequenceFlow id="flow-approved" name="Yes" sourceRef="approvedGateway" targetRef="typeGateway">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-rejected" name="No" sourceRef="approvedGateway" targetRef="reasonForRejection"/>
    <sequenceFlow id="flow-rejection-reason" sourceRef="reasonForRejection" targetRef="commercialGateway"/>
    <sequenceFlow id="flow-commercial-change" name="Yes" sourceRef="commercialGateway" targetRef="typeGateway">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${commercialChange == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-update-business" name="No" sourceRef="commercialGateway" targetRef="updateBusinessCase"/>
    <sequenceFlow id="flow-business-resubmit" sourceRef="updateBusinessCase" targetRef="submitApproval"/>

    <sequenceFlow id="flow-atb-final" name="ATB/BB" sourceRef="typeGateway" targetRef="updateAuthorityFinal">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${procurementType == 'ATB_BB'}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-moq-change" name="MOQ Change" sourceRef="typeGateway" targetRef="updateSap"/>
    <sequenceFlow id="flow-authority-sap" sourceRef="updateAuthorityFinal" targetRef="updateSap"/>
    <sequenceFlow id="flow-sap-im" sourceRef="updateSap" targetRef="sendApprovalToIm"/>
    <sequenceFlow id="flow-sap-orders" sourceRef="updateSap" targetRef="updateOrders"/>
    <sequenceFlow id="flow-im-cir" sourceRef="sendApprovalToIm" targetRef="openCirGateway"/>
    <sequenceFlow id="flow-open-cir" name="Yes" sourceRef="openCirGateway" targetRef="updateDeliveryDate">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${openCir == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-no-cir" name="No" sourceRef="openCirGateway" targetRef="endFunction"/>
    <sequenceFlow id="flow-cir-end" sourceRef="updateDeliveryDate" targetRef="endFunction"/>
    <sequenceFlow id="flow-im-orders" sourceRef="updateOrders" targetRef="updateBuyerPlanner"/>
    <sequenceFlow id="flow-im-end" sourceRef="updateBuyerPlanner" targetRef="endIm"/>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_procurementAuthorityV2">
    <bpmndi:BPMNPlane id="BPMNPlane_procurementAuthorityV2" bpmnElement="jlrAmpP023ProcurementAuthorityV2">
      <bpmndi:BPMNShape id="BPMNShape_lane_function" bpmnElement="lane_function" isHorizontal="true"><omgdc:Bounds x="0" y="0" width="3600" height="520"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_lane_im" bpmnElement="lane_im" isHorizontal="true"><omgdc:Bounds x="0" y="520" width="3600" height="220"/></bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BPMNShape_startProcurement" bpmnElement="startProcurement"><omgdc:Bounds x="40" y="220" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_procurementTypeStartGateway" bpmnElement="procurementTypeStartGateway"><omgdc:Bounds x="100" y="213" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_getQuotes" bpmnElement="getQuotes"><omgdc:Bounds x="130" y="100" width="130" height="70"/></bpmndi:BPMNShape>
