<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" xmlns:design="http://flowable.org/design" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://neo.com/workflow" exporter="Flowable Design" exporterVersion="2026.1.1" design:palette="flowable-work-process-palette">
  <process id="claimLifecycleV2" name="Claim Lifecycle" isExecutable="true">
    <extensionElements>
      <flowable:candidates-type><![CDATA[all]]></flowable:candidates-type>
      <design:stencilid><![CDATA[BPMNDiagram]]></design:stencilid>
      <design:creationdate><![CDATA[2026-10-07T14:37:52.579Z]]></design:creationdate>
      <design:modificationdate><![CDATA[2026-10-07T14:38:22.438Z]]></design:modificationdate>
    </extensionElements>
    <serviceTask id="recordSubmission" name="Record submission" flowable:expression="#{domainEvents.handle(execution, 'SUBMITTED')}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="notifyManager" name="Notify manager" flowable:expression="#{domainEvents.handle(execution, 'MANAGER_APPROVAL_REQUESTED')}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <userTask id="managerApproval" name="Manager approval" flowable:candidateGroups="${supervisorGroup}" flowable:dueDate="${managerReminderDuration}" flowable:formKey="managerApproval" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:task-candidates-type><![CDATA[all]]></flowable:task-candidates-type>
        <design:stencilid><![CDATA[FormTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </userTask>
    <serviceTask id="remindManager" name="Send reminder" flowable:expression="#{domainEvents.handle(execution, 'MANAGER_REMINDER')}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="escalateManager" name="Escalate to management" flowable:expression="#{domainEvents.handle(execution, 'MANAGER_ESCALATION')}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="finalizeRequest" name="Finalize claim" flowable:expression="#{domainEvents.finalizeRequest(execution)}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="confirmBooking" name="Confirm implementation" flowable:expression="#{domainEvents.confirmBooking(execution)}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="notifyOutcome" name="Notify approval" flowable:expression="#{domainEvents.handle(execution, 'FINAL_OUTCOME')}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <serviceTask id="notifyRejected" name="Notify rejection" flowable:expression="#{domainEvents.handle(execution, 'FINAL_OUTCOME')}">
      <extensionElements>
        <design:stencilid><![CDATA[ServiceTask]]></design:stencilid>
        <design:stencilsuperid><![CDATA[Task]]></design:stencilsuperid>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="hasDocumentsGateway" name="Documents attached?" default="flow-no-documents">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <exclusiveGateway id="managerDecisionGateway" name="Manager decision" default="flow-manager-not-approved">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <exclusiveGateway id="outcomeGateway" name="Outcome" default="flow-outcome-rejected">
      <extensionElements>
        <design:stencilid><![CDATA[Exclusive_Databased_Gateway]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </exclusiveGateway>
    <startEvent id="start" name="Claim submitted" flowable:formFieldValidation="false">
      <extensionElements>
        <flowable:work-form-field-validation><![CDATA[false]]></flowable:work-form-field-validation>
        <design:stencilid><![CDATA[StartNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </startEvent>
    <endEvent id="completed" name="Approved">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <endEvent id="rejected" name="Rejected">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <endEvent id="reminderSent" name="Reminder sent">
      <extensionElements>
        <design:stencilid><![CDATA[EndNoneEvent]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
    </endEvent>
    <sequenceFlow id="flow-recorded" sourceRef="recordSubmission" targetRef="hasDocumentsGateway">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-notified-manager" sourceRef="notifyManager" targetRef="managerApproval">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <boundaryEvent id="managerReminderTimer" name="Reminder" attachedToRef="managerApproval" cancelActivity="false">
      <extensionElements>
        <design:stencilid><![CDATA[IntermediateTimerEventBoundary]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>${managerReminderDuration}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flow-reminder" sourceRef="managerReminderTimer" targetRef="remindManager">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <boundaryEvent id="managerEscalationTimer" name="Escalation" attachedToRef="managerApproval" cancelActivity="true">
      <extensionElements>
        <design:stencilid><![CDATA[IntermediateTimerEventBoundary]]></design:stencilid>
        <design:display_ref_in_diagram><![CDATA[true]]></design:display_ref_in_diagram>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>${managerEscalationDuration}</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flow-escalation" sourceRef="managerEscalationTimer" targetRef="escalateManager">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-manager-decided" sourceRef="managerApproval" targetRef="managerDecisionGateway">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-reminder-end" sourceRef="remindManager" targetRef="reminderSent">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-escalated" sourceRef="escalateManager" targetRef="finalizeRequest">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-finalized" sourceRef="finalizeRequest" targetRef="outcomeGateway">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-booking-confirmed" sourceRef="confirmBooking" targetRef="notifyOutcome">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-approved-end" sourceRef="notifyOutcome" targetRef="completed">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-rejected-end" sourceRef="notifyRejected" targetRef="rejected">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-has-documents" sourceRef="hasDocumentsGateway" targetRef="notifyManager">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('hasDocuments') == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-no-documents" sourceRef="hasDocumentsGateway" targetRef="notifyManager">
      <extensionElements>
        <flowable:is-default-flow><![CDATA[true]]></flowable:is-default-flow>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-manager-not-approved" sourceRef="managerDecisionGateway" targetRef="finalizeRequest">
      <extensionElements>
        <flowable:is-default-flow><![CDATA[true]]></flowable:is-default-flow>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-outcome-approved" sourceRef="outcomeGateway" targetRef="confirmBooking">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('approved') == true}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow-outcome-rejected" sourceRef="outcomeGateway" targetRef="notifyRejected">
      <extensionElements>
        <flowable:is-default-flow><![CDATA[true]]></flowable:is-default-flow>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
    <sequenceFlow id="flow-start" sourceRef="start" targetRef="recordSubmission">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
    </sequenceFlow>
  </process>
