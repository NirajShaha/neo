# NextAuth Configuration
# IMPORTANT: Generate a secret for development and production
# On Windows PowerShell:
#   $bytes = New-Object byte[] 32; [Security.Cryptography.RNGCryptoServiceProvider]::new().GetBytes($bytes); [Convert]::ToBase64String($bytes)
# On Linux/Mac:
#   openssl rand -base64 32
AUTH_SECRET=your-secret-key-generate-one-for-your-environment

# Backend API Configuration (Spring Boot + Flowable)
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080
