      <bpmndi:BPMNShape id="BPMNShape_addTurnDown" bpmnElement="addTurnDown"><omgdc:Bounds x="1530" y="380" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateTurnDown" bpmnElement="updateTurnDown"><omgdc:Bounds x="1530" y="570" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateAuthorityWithImpact" bpmnElement="updateAuthorityWithImpact"><omgdc:Bounds x="1720" y="260" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_submitApproval" bpmnElement="submitApproval"><omgdc:Bounds x="1910" y="100" width="160" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approvedGateway" bpmnElement="approvedGateway"><omgdc:Bounds x="2120" y="115" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_reasonForRejection" bpmnElement="reasonForRejection"><omgdc:Bounds x="2220" y="250" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_commercialGateway" bpmnElement="commercialGateway"><omgdc:Bounds x="2410" y="260" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateBusinessCase" bpmnElement="updateBusinessCase"><omgdc:Bounds x="2510" y="380" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_typeGateway" bpmnElement="typeGateway"><omgdc:Bounds x="2280" y="115" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateAuthorityFinal" bpmnElement="updateAuthorityFinal"><omgdc:Bounds x="2410" y="40" width="160" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateSap" bpmnElement="updateSap"><omgdc:Bounds x="2620" y="100" width="140" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_sendApprovalToIm" bpmnElement="sendApprovalToIm"><omgdc:Bounds x="2810" y="100" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_openCirGateway" bpmnElement="openCirGateway"><omgdc:Bounds x="3010" y="115" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_updateDeliveryDate" bpmnElement="updateDeliveryDate"><omgdc:Bounds x="3110" y="40" width="180" height="80"/></bpmndi:BPMNShape>
