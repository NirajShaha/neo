      <bpmndi:BPMNShape id="BPMNShape_endFunction" bpmnElement="endFunction"><omgdc:Bounds x="3380" y="120" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_endIm" bpmnElement="endIm"><omgdc:Bounds x="3240" y="585" width="36" height="36"/></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="BPMNEdge_flow-start" bpmnElement="flow-start"><omgdi:waypoint x="76" y="238"/><omgdi:waypoint x="100" y="238"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-start-moq" bpmnElement="flow-start-moq"><omgdi:waypoint x="125" y="213"/><omgdi:waypoint x="125" y="190"/><omgdi:waypoint x="195" y="190"/><omgdi:waypoint x="195" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-start-atb" bpmnElement="flow-start-atb"><omgdi:waypoint x="125" y="263"/><omgdi:waypoint x="125" y="280"/><omgdi:waypoint x="195" y="280"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-request-forecast" bpmnElement="flow-request-forecast"><omgdi:waypoint x="260" y="315"/><omgdi:waypoint x="290" y="605"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-extended-forecast" bpmnElement="flow-extended-forecast"><omgdi:waypoint x="355" y="570"/><omgdi:waypoint x="195" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-quotes" bpmnElement="flow-quotes"><omgdi:waypoint x="260" y="135"/><omgdi:waypoint x="310" y="135"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-commercial" bpmnElement="flow-commercial"><omgdi:waypoint x="450" y="135"/><omgdi:waypoint x="490" y="135"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-impact" bpmnElement="flow-impact"><omgdi:waypoint x="640" y="135"/><omgdi:waypoint x="680" y="135"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-authority-log" bpmnElement="flow-authority-log"><omgdi:waypoint x="830" y="135"/><omgdi:waypoint x="870" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-atb-required" bpmnElement="flow-atb-required"><omgdi:waypoint x="920" y="140"/><omgdi:waypoint x="970" y="295"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-submit-no-atb" bpmnElement="flow-submit-no-atb"><omgdi:waypoint x="920" y="140"/><omgdi:waypoint x="1910" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-open-impact" bpmnElement="flow-open-impact"><omgdi:waypoint x="1120" y="295"/><omgdi:waypoint x="1160" y="298"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-wait-impact" bpmnElement="flow-wait-impact"><omgdi:waypoint x="1196" y="298"/><omgdi:waypoint x="1240" y="295"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-reference" bpmnElement="flow-reference"><omgdi:waypoint x="1390" y="295"/><omgdi:waypoint x="1430" y="300"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-impact-atb" bpmnElement="flow-impact-atb"><omgdi:waypoint x="1480" y="300"/><omgdi:waypoint x="1530" y="415"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-add-turn-down" bpmnElement="flow-add-turn-down"><omgdi:waypoint x="1480" y="300"/><omgdi:waypoint x="1720" y="295"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-turn-down" bpmnElement="flow-turn-down"><omgdi:waypoint x="1600" y="450"/><omgdi:waypoint x="1600" y="570"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-turn-down-authority" bpmnElement="flow-turn-down-authority"><omgdi:waypoint x="1670" y="605"/><omgdi:waypoint x="1795" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-impact-authority" bpmnElement="flow-impact-authority"><omgdi:waypoint x="1870" y="295"/><omgdi:waypoint x="1910" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-submit-approval" bpmnElement="flow-submit-approval"><omgdi:waypoint x="2070" y="140"/><omgdi:waypoint x="2120" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-approved" bpmnElement="flow-approved"><omgdi:waypoint x="2170" y="140"/><omgdi:waypoint x="2280" y="140"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-rejected" bpmnElement="flow-rejected"><omgdi:waypoint x="2145" y="165"/><omgdi:waypoint x="2290" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-rejection-reason" bpmnElement="flow-rejection-reason"><omgdi:waypoint x="2360" y="285"/><omgdi:waypoint x="2410" y="285"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-commercial-change" bpmnElement="flow-commercial-change"><omgdi:waypoint x="2435" y="260"/><omgdi:waypoint x="2305" y="165"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-update-business" bpmnElement="flow-update-business"><omgdi:waypoint x="2435" y="310"/><omgdi:waypoint x="2510" y="415"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-business-resubmit" bpmnElement="flow-business-resubmit"><omgdi:waypoint x="2585" y="380"/><omgdi:waypoint x="1990" y="180"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-atb-final" bpmnElement="flow-atb-final"><omgdi:waypoint x="2305" y="115"/><omgdi:waypoint x="2410" y="75"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-moq-change" bpmnElement="flow-moq-change"><omgdi:waypoint x="2330" y="165"/><omgdi:waypoint x="2620" y="135"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-authority-sap" bpmnElement="flow-authority-sap"><omgdi:waypoint x="2570" y="75"/><omgdi:waypoint x="2690" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_flow-sap-im" bpmnElement="flow-sap-im"><omgdi:waypoint x="2760" y="135"/><omgdi:waypoint x="2810" y="135"/></bpmndi:BPMNEdge>
