# Shared by `docker compose` and by local backend runs (apps/backend reads this file too).
# Copy to .env and fill in. Never commit .env.

# --- Database (compose) ---
MYSQL_ROOT_PASSWORD=manager
MYSQL_PORT=3306
BACKEND_PORT=8080
WEB_PORT=3000

# --- Okta (OIDC) ---
# Authorization-server issuer. Custom "default" server: https://<org>.okta.com/oauth2/default
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# Must equal the authorization server's Audience (default server: api://default)
OKTA_AUDIENCE=api://default
# Claim carrying the user's Okta group names (add it in Okta: Security > API > <server> > Claims)
OKTA_GROUPS_CLAIM=groups
# true: Okta groups are the source of truth for NEO group membership
OKTA_SYNC_GROUPS=true
# true: create the NEO user on first successful login
OKTA_AUTO_PROVISION=true
# Dev only: create demo users employee1/manager1/finance1@neo.dev (bind to Okta users with the same email)
NEO_SEED_DEMO_USERS=false

# --- Web app (compose passes these to the web container) ---
# Public URL users type in the browser; must match the Okta sign-in redirect URI origin
APP_URL=http://localhost:3000
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_SCOPES=openid profile email groups offline_access
# >= 32 random chars, encrypts the session cookie:  openssl rand -base64 48
NEO_SESSION_SECRET=
