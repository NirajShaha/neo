# Used by `pnpm web:dev` (copy to apps/web/.env.local). Server-side only; nothing here reaches the browser.
BACKEND_URL=http://localhost:8080

# Public URL of this app; Okta redirects to ${APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# Okta OIDC "Web application" (Authorization Code + PKCE, client secret auth)
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_SCOPES=openid profile email groups offline_access

# >= 32 random chars, encrypts the session cookie:  openssl rand -base64 48
NEO_SESSION_SECRET=
